GOOGLE_API_KEY=replace_with_a_new_rotated_key
MCP_TOKEN=replace_with_a_long_random_token
APP_USERNAME=energy-admin
APP_PASSWORD=replace_with_a_long_unique_password

# Use a DNS name such as energy.example.com for automatic HTTPS.
# Without a domain, use :80 and PUBLIC_ORIGIN=http://SERVER_IP.
APP_DOMAIN=:80
PUBLIC_ORIGIN=http://SERVER_IP
IMAGE_TAG=latest
GEMINI_MODEL=gemini-3.1-flash-lite
MEMORY_RECENT_TURNS=12
MEMORY_SUMMARY_CHARS=10000
MAX_PARALLEL_AGENTS=4
