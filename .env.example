# ============================================
# EnergyPlus MCP Agent Configuration
# ============================================

# Google Gemini API Key (REQUIRED)
# Get your key from: https://aistudio.google.com/apikey
# Paste your API key below:
GOOGLE_API_KEY=your_gemini_api_key_here
MCP_TOKEN=replace_with_a_long_random_local_token

# Gemini Model (optional, default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.1-flash-lite

# Multi-agent memory and execution
MEMORY_RECENT_TURNS=12
MEMORY_SUMMARY_CHARS=10000
MAX_PARALLEL_AGENTS=4
ENERGY_AGENT_DATA_DIR=runtime
PORT=5000
